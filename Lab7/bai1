#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char s[200];
    int vowel = 0, consonant = 0;

    printf("Nhap chuoi: ");
    gets(s);

    for (int i = 0; s[i] != '\0'; i++) {
        char c = tolower(s[i]); // chuyển về chữ thường

        if (c >= 'a' && c <= 'z') {   
            if (c=='a' || c=='e' || c=='i' || c=='o' || c=='u')
                vowel++;
            else
                consonant++;
        }
    }

    printf("So nguyen am: %d\n", vowel);
    printf("So phu am: %d\n", consonant);

    return 0;
}
